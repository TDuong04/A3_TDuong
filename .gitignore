# Environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Scratch
scratch/
*.tmp

# Shared AI tooling. CLAUDE.md, the agent roster and the lecture reference are committed so that
# every member's Claude Code session starts from the same context. Only local, per-machine settings
# stay untracked. Delete .claude/ before building the submission zip if you would rather not ship it.
.claude/*
!.claude/agents/
!.claude/A3-lecture-reference.md

# NOTE: models/ logs/ and results/ are deliberately NOT ignored.
# The brief requires saved models and TensorBoard logs inside the submitted zip.
# Do not add them here.

.history/

# Only recovery scaffolding is ignored here: weights that regenerate for free and that nobody
# reads back. A hyperparameter sweep writes roughly 7MB of these per run, so they compound —
# unlike the figures, curves, event files and tickets, which are read, reviewed and submitted.
logs/**/*.zip
models/checkpoints/
